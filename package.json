{
  "name": "furlife",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:validate": "corepack pnpm --filter @furlife/backend prisma:validate",
    "db:migrate:dev": "corepack pnpm --filter @furlife/backend prisma:migrate:dev",
    "db:migrate:deploy": "corepack pnpm --filter @furlife/backend prisma:migrate:deploy",
    "baseline:check": "node scripts/verify-baseline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "eslint": "9.22.0",
    "typescript-eslint": "8.26.0"
  }
}

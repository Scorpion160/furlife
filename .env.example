# Copy to .env.local for development. Never commit .env.local.
APP_ENV=development
API_PORT=8080
TRUST_PROXY_HOPS=0

# Dedicated Furlife host ports avoid collisions with existing local services.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001

DATABASE_URL=postgresql://furlife:CHANGE_ME_DB@localhost:55432/furlife?schema=public
REDIS_URL=redis://localhost:56379

S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=furlife-dev
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS
S3_SECRET_KEY=CHANGE_ME_S3_SECRET

PRIVACY_HASH_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
OTP_HASH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=console
# Explicit opt-in only for local development. Must be false in production.
OTP_DEV_EXPOSE_CODE=false

# Comma-separated exact origins. Empty = CORS disabled.
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
ADMIN_MFA_REQUIRED=true

# Development infrastructure only
POSTGRES_DB=furlife
POSTGRES_USER=furlife
POSTGRES_PASSWORD=CHANGE_ME_DB
MINIO_ROOT_USER=CHANGE_ME_S3_ACCESS
MINIO_ROOT_PASSWORD=CHANGE_ME_S3_SECRET
# Pin a verified MinIO tag before first staging/production deployment.
MINIO_IMAGE_TAG=latest
